{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"trailingSlash": true,
	"headers": [
		{
			"source": "/spec/:version/schemas/:schema",
			"headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
		}
	]
}
